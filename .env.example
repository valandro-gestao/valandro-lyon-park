# =============================================================================
# LYON PARK — VARIÁVEIS DE AMBIENTE
# Arquivo de referência. NÃO adicionar valores reais aqui.
# Copie para .env (nunca versionado) e preencha os valores reais.
# Em produção, configure as variáveis diretamente na plataforma de hospedagem (Render).
# =============================================================================

# -----------------------------------------------------------------------------
# Autenticação de acesso à aplicação
#
# ATENÇÃO — use SEMPRE arquivo .env para desenvolvimento local.
# NUNCA faça: export AUTH_USERS_YAML="..." no shell.
# Hashes bcrypt contêm $ que o shell interpola como variáveis, corrompendo o hash.
# O arquivo .env é lido pelo Python (python-dotenv) sem nenhuma interpolação.
#
# Formato correto no arquivo .env:
#   - Use aspas SIMPLES ao redor do bloco YAML completo
#   - O hash bcrypt fica sem aspas dentro do YAML
#   - Indentação com 2 espaços
#
# Como gerar os valores:
#   Hash bcrypt da senha:
#     .venv/bin/python -c "import bcrypt; print(bcrypt.hashpw(b'SUA_SENHA', bcrypt.gensalt(12)).decode())"
#
#   Chave de cookie (32+ caracteres):
#     .venv/bin/python -c "import secrets; print(secrets.token_hex(32))"
#
# Exemplo de .env real (substitua os valores fictícios):
#
# AUTH_USERS_YAML='credentials:
#   usernames:
#     operador:
#       name: Operador Lyon Park
#       password: $2b$12$SUBSTITUA_PELO_HASH_BCRYPT_REAL
# cookie:
#   name: lyon_auth
#   key: CHAVE_ALEATORIA_MINIMO_32_CARACTERES
#   expiry_days: 7'
#
# Para adicionar mais usuários, adicione novas entradas em credentials.usernames.
# -----------------------------------------------------------------------------
AUTH_USERS_YAML=


# -----------------------------------------------------------------------------
# Diretório de dados
# Desenvolvimento local: deixar vazio (usa ./data por padrão)
# Produção no Render:    /mnt/data
# -----------------------------------------------------------------------------
DATA_DIR=


# -----------------------------------------------------------------------------
# Ambiente de execução
# -----------------------------------------------------------------------------
APP_ENV=development


# -----------------------------------------------------------------------------
# Diagnóstico de autenticação
# DEBUG_AUTH=1 exibe na UI dados sobre o YAML carregado (sem expor hashes).
# Usar apenas para diagnóstico local. Setar 0 ou remover em produção.
# -----------------------------------------------------------------------------
DEBUG_AUTH=0
